@@ -0,0 +1,13 @@
+import Foundation
+import CoreGraphics
+
+/// A coordinate hit may be pressed semantically only when its identity and
+/// enabled state are known. Browser content keeps the existing event path.
+func permitsCoordinatePress(role: String, enabled: Bool?, actions: Set<String>, inWeb: Bool) -> Bool {
+    let roles: Set<String> = ["AXButton", "AXCheckBox", "AXRadioButton", "AXMenuItem", "AXLink"]
+    return enabled == true && !inWeb && roles.contains(role) && actions.contains("AXPress")
+}
+
+func pointInTargetWindow(point: CGPoint, frame: CGRect) -> Bool {
+    !frame.isEmpty && frame.contains(point)
+}
