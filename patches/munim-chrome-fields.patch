@@ -0,0 +1,24 @@
+import AppKit
+import ApplicationServices
+
+// Chromium returns .noValue for normal text fields and identifies password
+// fields by their secure subrole. Other errors remain unknown, not safe.
+func handsmcpFieldRole(role: String?, subrole: String?, subroleStatus: AXError, chrome: Bool = true) -> String {
+    guard let role, !role.isEmpty else { return "AXUnverifiedTextField" }
+    if role == "AXSecureTextField" || subrole == "AXSecureTextField" { return "AXSecureTextField" }
+    if role == "AXTextField" && subrole == nil {
+        if chrome && subroleStatus == .noValue { return role }
+        return "AXUnverifiedTextField"
+    }
+    return role
+}
+func handsmcpLiveFieldRole(_ element: AXUIElement) -> String {
+    var roleValue: CFTypeRef?
+    let roleStatus = AXUIElementCopyAttributeValue(element, kAXRoleAttribute as CFString, &roleValue)
+    var subroleValue: CFTypeRef?
+    let subroleStatus = AXUIElementCopyAttributeValue(element, kAXSubroleAttribute as CFString, &subroleValue)
+    let role = roleStatus == .success ? roleValue as? String : nil
+    let subrole = subroleStatus == .success ? subroleValue as? String : nil
+    let chrome = pidOf(element).flatMap { NSRunningApplication(processIdentifier: $0)?.bundleIdentifier } == "com.google.Chrome"
+    return handsmcpFieldRole(role: role, subrole: subrole, subroleStatus: subroleStatus, chrome: chrome)
+}
