+/// Additional fail-closed target checks for the narrow handsmcp gateway.
+func handsmcpTargetMatches(_ element: AXUIElement, bundle: String, role: String, name: String? = nil, focused: Bool = false) -> Bool {
+    guard let pid = pidOf(element), let app = NSRunningApplication(processIdentifier: pid),
+          app.bundleIdentifier?.lowercased() == bundle.lowercased(), trustedSystemAppPath(app),
+          axString(element, kAXRoleAttribute as String) == role else { return false }
+    if let name {
+        guard (axString(element, kAXTitleAttribute as String) ?? axString(element, kAXDescriptionAttribute as String)) == name else { return false }
+    }
+    if focused {
+        guard let current = axElement(AXUIElementCreateApplication(pid), kAXFocusedUIElementAttribute as String),
+              CFEqual(current, element) else { return false }
+    }
+    return true
+}
