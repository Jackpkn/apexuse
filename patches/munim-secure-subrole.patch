+/// Restrict input-enabled Apple app identities to their sealed system paths.
+func trustedSystemAppPath(_ app: NSRunningApplication) -> Bool {
+    let paths = ["com.apple.textedit": "/System/Applications/TextEdit.app",
+                 "com.apple.calculator": "/System/Applications/Calculator.app"]
+    guard let bundle = app.bundleIdentifier?.lowercased(), let expected = paths[bundle] else { return true }
+    return app.bundleURL?.resolvingSymlinksInPath().path == expected
+}
